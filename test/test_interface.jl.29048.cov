        - @testset "container-agnostic interface" begin
        -     Random.seed!(4)
        - 
        -     # 1. Plain Vector -- the zero-copy fast path
        -     v = randn(300)
        -     @test tsvalues(v) === v                       # literally the same object, no copy
        -     @test tsindex(v) === nothing
        - 
        -     # 2. A Range -- no package involved at all
        -     r = 1:100
        -     @test tsvalues(r) == collect(Float64, r)
        -     @test acf(r).n == 100                          # works end-to-end through a public function
        - 
        -     # 3. A lazy iterator (Base.Generator) -- proves materialization happens
        -     #    correctly for something that isn't indexable until collected
        -     gen = (sin(i) for i in 1:200)
        -     vals = tsvalues(gen)
        -     @test vals isa Vector{Float64}
        -     @test length(vals) == 200
        - 
        -     # 4. A mock "external package" container TSAnalytics has never heard of.
        -     #    This stands in for TSFrames.TSFrame / TimeSeries.TimeArray / a
        -     #    DataFrames column / anything written after this package -- the
        -     #    point is that NO code in TSAnalytics.jl mentions this type by name.
        -     struct MockExternalSeries
        1         data::Vector{Float64}
        -         dates::Vector{Int}   # standing in for real Dates.Date
        -     end
      909     Base.iterate(m::MockExternalSeries, state=1) =
        -         state > length(m.data) ? nothing : (m.data[state], state + 1)
        3     Base.length(m::MockExternalSeries) = length(m.data)
        -     Base.eltype(::Type{MockExternalSeries}) = Float64
        - 
        -     mock = MockExternalSeries(randn(150), collect(1:150))
        - 
        -     # Default fallback (collect) already works with zero TSAnalytics-side
        -     # knowledge of MockExternalSeries:
        -     @test tsvalues(mock) isa Vector{Float64}
        -     @test length(tsvalues(mock)) == 150
        -     r1 = acf(mock, 0:5)
        -     @test length(r1.values) == 6
        - 
        -     # A container author (or the user) can opt into a custom, more
        -     # efficient/aware method with a single line -- ordinary dispatch,
        -     # no extension mechanism, no new dependency in either direction:
        1     TSAnalytics.tsvalues(m::MockExternalSeries) = m.data      # zero-copy override
        1     TSAnalytics.tsindex(m::MockExternalSeries) = m.dates
        -     @test tsvalues(mock) === mock.data
        -     @test tsindex(mock) == mock.dates
        - 
        -     # 5. Confirm every public diagnostic function threads through the same
        -     #    interface, not just acf/pacf.
        -     x = randn(500)
        -     @test adf_test(x).n isa Int
        -     @test kpss_test(x).n isa Int
        -     @test ljungbox_test(x, 10).df == 10
        -     @test qs_test(sin.(2π .* (1:500) ./ 12) .+ 0.1 .* randn(500), 12).period == 12
        - 
        -     # and via the range/generator path too, to confirm no function was missed
        -     @test adf_test(collect(1.0:500) .+ randn(500)) isa TSAnalytics.ADFTest
        - end
